    rdfs:label "Data Table in File Summary" .
ex:Photon_s_Phase_Fingerprint_on_Particles_File_Summary ex:hasDataTable ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_2 .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_2_Row_0 a ex:TableRow .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_2 ex:hasRow ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_2_Row_0 .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_2_Row_0 ex:Component "Cryogenic Filters" .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_2_Row_0 ex:Role_of_VACNT "Mixed into a \"lossy\" epoxy or powder inside the signal lines." .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_2_Row_0 ex:Benefit "Attenuates high-frequency noise while letting the control signals pass through." .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_2_Row_1 a ex:TableRow .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_2 ex:hasRow ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_2_Row_1 .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_2_Row_1 ex:Component "Thermal Anchors" .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_2_Row_1 ex:Role_of_VACNT "Used to \"sink\" heat from the electronics to the fridge." .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_2_Row_1 ex:Benefit "VACNTs have incredible thermal conductivity along their axis, helping keep qubits at 10 mK." .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_3 a ex:DataTable ;
    rdfs:label "Data Table in File Summary" .
ex:Photon_s_Phase_Fingerprint_on_Particles_File_Summary ex:hasDataTable ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_3 .
