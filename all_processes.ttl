ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_Proposed_Schedule_0_Row_1 ex:Duration "10 – 11 sec" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_Proposed_Schedule_0_Row_1 ex:Action_Voltage_Current "High Current Spike(10x Normal Amps)Duration: ~500ms" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_Proposed_Schedule_0_Row_1 ex:Role_of_Supercapacitor "Full Discharge(Dump 20kW/kg power instantly)" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_Proposed_Schedule_0_Row_1 ex:Physics_Mechanism "Rapid Nucleation:The massive energy surge forces millions of tiny carbon seeds to formsimultaneously. This high density is crucial; if they grow close together, theymustgrow straight up." .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_Proposed_Schedule_0_Row_2 a ex:TableRow .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_Proposed_Schedule_0 ex:hasRow ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_Proposed_Schedule_0_Row_2 .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_Proposed_Schedule_0_Row_2 ex:Phase "3. The \"Grow\"(Steady State)" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_Proposed_Schedule_0_Row_2 ex:Duration "11 – 60 sec" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_Proposed_Schedule_0_Row_2 ex:Action_Voltage_Current "Steady DC(Normal Amps)Voltage: ~1.5V - 2.0V" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_Proposed_Schedule_0_Row_2 ex:Role_of_Supercapacitor "Recharging(Absorbing grid energy)" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_Proposed_Schedule_0_Row_2 ex:Physics_Mechanism "Vertical Growth:The tubes lengthen. Because the \"Blast\" phase packed them so tightly, they support each other like a bundle of uncooked spaghetti." .
