ex:Table_CNT_Bandgap_Creation_with_Lignin_Vitrimer_File_Summary_40 ex:hasRow ex:Table_CNT_Bandgap_Creation_with_Lignin_Vitrimer_File_Summary_40_Row_0 .
ex:Table_CNT_Bandgap_Creation_with_Lignin_Vitrimer_File_Summary_40_Row_0 ex:Feature "Strain/Chirality" .
ex:Table_CNT_Bandgap_Creation_with_Lignin_Vitrimer_File_Summary_40_Row_0 ex:Factory_Tool_High_Speed "Hyperspectral Imaging (HSI)" .
ex:Table_CNT_Bandgap_Creation_with_Lignin_Vitrimer_File_Summary_40_Row_0 ex:R_D_Lab_Tool_High_Precision "Raman Spectroscopy" .
ex:Table_CNT_Bandgap_Creation_with_Lignin_Vitrimer_File_Summary_40_Row_0 ex:Why "Raman is the \"Gold Standard\" for CNTs.It directly measures bond vibration. A shift in the \"G-Band\" peak proves strain. It is standard in chem labs (no vacuum)." .
ex:Table_CNT_Bandgap_Creation_with_Lignin_Vitrimer_File_Summary_40_Row_1 a ex:TableRow .
ex:Table_CNT_Bandgap_Creation_with_Lignin_Vitrimer_File_Summary_40 ex:hasRow ex:Table_CNT_Bandgap_Creation_with_Lignin_Vitrimer_File_Summary_40_Row_1 .
ex:Table_CNT_Bandgap_Creation_with_Lignin_Vitrimer_File_Summary_40_Row_1 ex:Feature "Structure/Height" .
ex:Table_CNT_Bandgap_Creation_with_Lignin_Vitrimer_File_Summary_40_Row_1 ex:Factory_Tool_High_Speed "Terahertz Scanner (THz)" .
ex:Table_CNT_Bandgap_Creation_with_Lignin_Vitrimer_File_Summary_40_Row_1 ex:R_D_Lab_Tool_High_Precision "Atomic Force Microscope (AFM)" .
ex:Table_CNT_Bandgap_Creation_with_Lignin_Vitrimer_File_Summary_40_Row_1 ex:Why "AFM \"feels\" the surface.It is theonlynon-SEM way to verify a 2nm tube is inside a 2nm trench. It is slow but has atomic resolution." .
