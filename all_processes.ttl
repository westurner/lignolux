ex:CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary ex:hasDataTable ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_2 .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_2_Row_0 a ex:TableRow .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_2 ex:hasRow ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_2_Row_0 .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_2_Row_0 ex:Technology "Bast Fiber Supercapacitors" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_2_Row_0 ex:Role_in_Untangling_the_CNTs "The Pulse Driver.Use them to store energy and release it in millisecond \"kicks\" (Pulsed DC) to snap the CNTs into vertical alignment during growth." .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_2_Row_0 ex:Verdict "High Potential" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_2_Row_1 a ex:TableRow .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_2 ex:hasRow ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_2_Row_1 .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_2_Row_1 ex:Technology "THz Pulses" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_2_Row_1 ex:Role_in_Untangling_the_CNTs "The Sensor.Do not use forgrowth. Use THzafterproduction to non-destructively test if your wire is conductive (Metallic) or resistive (Semiconducting)." .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_2_Row_1 ex:Verdict "Low Potential for Alignment" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3 a ex:DataTable ;
    rdfs:label "Data Table in File Summary" .
ex:CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary ex:hasDataTable ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3 .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_0 a ex:TableRow .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3 ex:hasRow ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_0 .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_0 ex:Phase "1. The \"Wake Up\"" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_0 ex:Duration "0 – 10 sec" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_0 ex:Action_Voltage_Current "Reverse Polarity(-1.0V)" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_0 ex:Role_of_Supercapacitor "Idle" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_0 ex:Physics_Mechanism "Strips the cathode surface of any oxides or old carbon. Prepares a \"clean slate\" for nucleation." .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_1 a ex:TableRow .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3 ex:hasRow ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_1 .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_1 ex:Phase "2. The \"Blast\"(Nucleation)" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_1 ex:Duration "10 – 11 sec" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_1 ex:Action_Voltage_Current "High Current Spike(10x Normal Amps)Duration: ~500ms" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_1 ex:Role_of_Supercapacitor "Full Discharge(Dump 20kW/kg power instantly)" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_1 ex:Physics_Mechanism "Rapid Nucleation:The massive energy surge forces millions of tiny carbon seeds to formsimultaneously. This high density is crucial; if they grow close together, theymustgrow straight up." .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_2 a ex:TableRow .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3 ex:hasRow ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_2 .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_2 ex:Phase "3. The \"Grow\"(Steady State)" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_2 ex:Duration "11 – 60 sec" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_2 ex:Action_Voltage_Current "Steady DC(Normal Amps)Voltage: ~1.5V - 2.0V" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_2 ex:Role_of_Supercapacitor "Recharging(Absorbing grid energy)" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_2 ex:Physics_Mechanism "Vertical Growth:The tubes lengthen. Because the \"Blast\" phase packed them so tightly, they support each other like a bundle of uncooked spaghetti." .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_3 a ex:TableRow .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3 ex:hasRow ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_3 .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_3 ex:Phase "4. The \"Shake\"(Maintenance)" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_3 ex:Duration "Every 60 sec" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_3 ex:Action_Voltage_Current "Medium Pulse(3x Normal Amps)Duration: ~100ms" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_3 ex:Role_of_Supercapacitor "Partial Discharge" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_3_Row_3 ex:Physics_Mechanism "Clearing the Double Layer:A quick kick disrupts the ion cloud (diffusion layer) preventing the \"starvation\" that causes tubes to curl or spiral." .
