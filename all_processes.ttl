ex:Table_Rare_Earth_Free_Permanent_Magnet_Alternatives_Key_Risks_Mitigations_0 ex:hasRow ex:Table_Rare_Earth_Free_Permanent_Magnet_Alternatives_Key_Risks_Mitigations_0_Row_0 .
ex:Table_Rare_Earth_Free_Permanent_Magnet_Alternatives_Key_Risks_Mitigations_0_Row_0 ex:Risk_Area "Feedstock" .
ex:Table_Rare_Earth_Free_Permanent_Magnet_Alternatives_Key_Risks_Mitigations_0_Row_0 ex:Challenge "Red Mud variability (silica spikes) poisons the reduction." .
ex:Table_Rare_Earth_Free_Permanent_Magnet_Alternatives_Key_Risks_Mitigations_0_Row_0 ex:Mitigation_Strategy "Spectral AI:The plasma reactor will use real-time optical emission spectroscopy (OES) to auto-adjust power if impurities spike." .
ex:Table_Rare_Earth_Free_Permanent_Magnet_Alternatives_Key_Risks_Mitigations_0_Row_1 a ex:TableRow .
ex:Table_Rare_Earth_Free_Permanent_Magnet_Alternatives_Key_Risks_Mitigations_0 ex:hasRow ex:Table_Rare_Earth_Free_Permanent_Magnet_Alternatives_Key_Risks_Mitigations_0_Row_1 .
ex:Table_Rare_Earth_Free_Permanent_Magnet_Alternatives_Key_Risks_Mitigations_0_Row_1 ex:Risk_Area "Thermal" .
ex:Table_Rare_Earth_Free_Permanent_Magnet_Alternatives_Key_Risks_Mitigations_0_Row_1 ex:Challenge "Sand Battery fails to maintain stable 600°C output." .
ex:Table_Rare_Earth_Free_Permanent_Magnet_Alternatives_Key_Risks_Mitigations_0_Row_1 ex:Mitigation_Strategy "Hybrid Heating:The reactor includes backup electric heaters to smooth out any temperature dips from the air loop." .
ex:Table_Rare_Earth_Free_Permanent_Magnet_Alternatives_Key_Risks_Mitigations_0_Row_2 a ex:TableRow .
ex:Table_Rare_Earth_Free_Permanent_Magnet_Alternatives_Key_Risks_Mitigations_0 ex:hasRow ex:Table_Rare_Earth_Free_Permanent_Magnet_Alternatives_Key_Risks_Mitigations_0_Row_2 .
ex:Table_Rare_Earth_Free_Permanent_Magnet_Alternatives_Key_Risks_Mitigations_0_Row_2 ex:Risk_Area "Safety" .
ex:Table_Rare_Earth_Free_Permanent_Magnet_Alternatives_Key_Risks_Mitigations_0_Row_2 ex:Challenge "Hydrogen leak in a brownfield industrial site." .
ex:Table_Rare_Earth_Free_Permanent_Magnet_Alternatives_Key_Risks_Mitigations_0_Row_2 ex:Mitigation_Strategy "Containerized H2:The hydrogen supply will be a standalone, outdoor \"tube trailer\" with auto-shutoff valves, separated from the main building." .
ex:Table_Rare_Earth_Free_Permanent_Magnet_Alternatives_Key_Risks_Mitigations_0_Row_3 a ex:TableRow .
ex:Table_Rare_Earth_Free_Permanent_Magnet_Alternatives_Key_Risks_Mitigations_0 ex:hasRow ex:Table_Rare_Earth_Free_Permanent_Magnet_Alternatives_Key_Risks_Mitigations_0_Row_3 .
ex:Table_Rare_Earth_Free_Permanent_Magnet_Alternatives_Key_Risks_Mitigations_0_Row_3 ex:Risk_Area "Process" .
ex:Table_Rare_Earth_Free_Permanent_Magnet_Alternatives_Key_Risks_Mitigations_0_Row_3 ex:Challenge "Magnet powder oxidizes before assembly." .
ex:Table_Rare_Earth_Free_Permanent_Magnet_Alternatives_Key_Risks_Mitigations_0_Row_3 ex:Mitigation_Strategy "Inert Conveyance:The powder moves from Reactor→Separator→FuseRing inside sealed, Argon-filled transfer hoppers." .
