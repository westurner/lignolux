ex:Red_and_Blue_Laser_Beam_Mixing_The_Mining_GPU_Whitening_Kernels a iof:PlannedProcess ;
    rdfs:label "4\\. The \"Mining\" (GPU Whitening Kernels)" .
ex:Red_and_Blue_Laser_Beam_Mixing_The_Mining_GPU_Whitening_Kernels ex:input "A massive block of biased, raw optical data (e.g., 1 MB block holding 50% entropy)." .
<< ex:Red_and_Blue_Laser_Beam_Mixing_The_Mining_GPU_Whitening_Kernels ex:input "A massive block of biased, raw optical data (e.g., 1 MB block holding 50% entropy)." >> ex:confidence 0.8 ;
    ex:extractionSource "MyST-Parser-Regex" .
ex:Red_and_Blue_Laser_Beam_Mixing_The_Mining_GPU_Whitening_Kernels ex:process "The GPU cores apply cryptographic hash functions (like SHA-3, BLAKE3, or Keccak) in parallel across the data block. Hashing acts as a \"randomness extractor.\" It compresses the large, biased input block into a smaller, statistically perfect output block (e.g., compressing 1024 raw bits down to 256 clean bits)." .
<< ex:Red_and_Blue_Laser_Beam_Mixing_The_Mining_GPU_Whitening_Kernels ex:process "The GPU cores apply cryptographic hash functions (like SHA-3, BLAKE3, or Keccak) in parallel across the data block. Hashing acts as a \"randomness extractor.\" It compresses the large, biased input block into a smaller, statistically perfect output block (e.g., compressing 1024 raw bits down to 256 clean bits)." >> ex:confidence 0.8 ;
    ex:extractionSource "MyST-Parser-Regex" .
ex:Red_and_Blue_Laser_Beam_Mixing_The_Mining_GPU_Whitening_Kernels ex:nist_health_check "A small percentage of GPU cores dedicatedly run statistical tests (SP 800-90B) on the output in real-time to detect if an LED has failed." .
<< ex:Red_and_Blue_Laser_Beam_Mixing_The_Mining_GPU_Whitening_Kernels ex:nist_health_check "A small percentage of GPU cores dedicatedly run statistical tests (SP 800-90B) on the output in real-time to detect if an LED has failed." >> ex:confidence 0.8 ;
    ex:extractionSource "MyST-Parser-Regex" .
