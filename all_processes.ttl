ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_1_Row_0 ex:Method "KIST \"Wet-Spinning\"" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_1_Row_0 ex:Estimated_Cost_kg "~$300 – $500" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_1_Row_0 ex:Primary_Cost_Driver "Processing:Liquid crystal purification + Wet spinning acids." .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_1_Row_0 ex:Suitability_for_Motors_Conductivity "High:Aligned, dense, metallic-like." .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_1_Row_1 a ex:TableRow .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_1 ex:hasRow ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_1_Row_1 .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_1_Row_1 ex:Method "CO2 Electrolysis(Molten Salt)" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_1_Row_1 ex:Estimated_Cost_kg "~$1 – $10(Target)~$50(Current)" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_1_Row_1 ex:Primary_Cost_Driver "Energy:Electricity for electrolysis (Feedstock is negative cost)." .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_1_Row_1 ex:Suitability_for_Motors_Conductivity "Low/Medium:Often tangled \"wool\" or powders; requires post-processing to be a wire." .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_1_Row_2 a ex:TableRow .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_1 ex:hasRow ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_1_Row_2 .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_1_Row_2 ex:Method "Plasma Torch" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_1_Row_2 ex:Estimated_Cost_kg "~$50 – $150(MWCNT)~$10,000(SWCNT)" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_1_Row_2 ex:Primary_Cost_Driver "Capex:High-energy plasma equipment; lower yield of perfect tubes." .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_1_Row_2 ex:Suitability_for_Motors_Conductivity "Medium:Good bulk conductivity, but hard to align into wires." .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_1_Row_3 a ex:TableRow .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_1 ex:hasRow ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_1_Row_3 .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_1_Row_3 ex:Method "Metallic Separation(DGU)" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_1_Row_3 ex:Estimated_Cost_kg "$10,000+" .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_1_Row_3 ex:Primary_Cost_Driver "Yield Loss:discarding 66% of product (semiconducting) + expensive surfactants." .
ex:Table_CNT_Cables_2_vs_Copper_Aluminum_Cost_File_Summary_1_Row_3 ex:Suitability_for_Motors_Conductivity "Ultimate:Pure metallic conductivity, but economically impossible for motors." .
