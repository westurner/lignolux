    rdfs:label "The Optocoupler Hack" .
ex:Red_and_Blue_Laser_Beam_Mixing_The_Barebones_Entropy_Source ex:the_parts "Two cheap LEDs and a High-Speed Phototransistor (or an Optocoupler with the top sanded off)." .
<< ex:Red_and_Blue_Laser_Beam_Mixing_The_Barebones_Entropy_Source ex:the_parts "Two cheap LEDs and a High-Speed Phototransistor (or an Optocoupler with the top sanded off)." >> ex:confidence 0.8 ;
    ex:extractionSource "MyST-Parser-Regex" .
ex:Red_and_Blue_Laser_Beam_Mixing_The_Barebones_Entropy_Source ex:the_process "1. Point two LEDs directly at one phototransistor at point-blank range (millimeters). 2. Run the LEDs at their \"knee\" voltage (where they just start to turn on). This is where quantum shot noise is highest. 3. The phototransistor picks up the combined, fluctuating \"beat\" of the two sources." .
<< ex:Red_and_Blue_Laser_Beam_Mixing_The_Barebones_Entropy_Source ex:the_process "1. Point two LEDs directly at one phototransistor at point-blank range (millimeters). 2. Run the LEDs at their \"knee\" voltage (where they just start to turn on). This is where quantum shot noise is highest. 3. The phototransistor picks up the combined, fluctuating \"beat\" of the two sources." >> ex:confidence 0.8 ;
    ex:extractionSource "MyST-Parser-Regex" .
