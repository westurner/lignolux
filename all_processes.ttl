    rdfs:label "\"Intensity Distribution Histogram\"" .
ex:Red_and_Blue_Laser_Beam_Mixing_The_Right_Plot ex:the_shape "Notice it is not a bell curve (Gaussian). It has a long tail towards high intensity and a peak near zero. This is characteristic of \"fully developed speckle.\"" .
<< ex:Red_and_Blue_Laser_Beam_Mixing_The_Right_Plot ex:the_shape "Notice it is not a bell curve (Gaussian). It has a long tail towards high intensity and a peak near zero. This is characteristic of \"fully developed speckle.\"" >> ex:confidence 0.8 ;
    ex:extractionSource "MyST-Parser-Regex" .
ex:Red_and_Blue_Laser_Beam_Mixing_The_Right_Plot ex:why_it_matters "This wide distribution confirms that your \"raw\" analog signal will have a high dynamic range—swinging wildly from dark to bright—which is exactly what you want for generating high-quality entropy before whitening." .
<< ex:Red_and_Blue_Laser_Beam_Mixing_The_Right_Plot ex:why_it_matters "This wide distribution confirms that your \"raw\" analog signal will have a high dynamic range—swinging wildly from dark to bright—which is exactly what you want for generating high-quality entropy before whitening." >> ex:confidence 0.8 ;
