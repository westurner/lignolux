ex:Speckle_Metamaterials_and_Fast_Sensing_File_Summary ex:hasDataTable ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_25 .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_25_Row_0 a ex:TableRow .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_25 ex:hasRow ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_25_Row_0 .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_25_Row_0 ex:Feature "RF Absorption" .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_25_Row_0 ex:Graphene_Foam_rGO "High.Sheets absorb broad-spectrum RF. Tunable by density." .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_25_Row_0 ex:CNT_Foam "Highest.The entangled \"forest\" structure traps waves more effectively (like Vantablack for RF)." .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_25_Row_0 ex:Foamed_Lignin "Low to Medium.Only conductive if carbonized (>900∘C). Otherwise, it is transparent to RF." .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_25_Row_1 a ex:TableRow .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_25 ex:hasRow ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_25_Row_1 .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_25_Row_1 ex:Feature "Thermal Conductivity" .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_25_Row_1 ex:Graphene_Foam_rGO "Excellent (>100 W/mK).It is a phononic superhighway." .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_25_Row_1 ex:CNT_Foam "Good.But contact resistance between tubes limits bulk transfer." .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_25_Row_1 ex:Foamed_Lignin "Poor (Insulator).Great for keeping the rest of the chip cool, bad for removing heat." .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_25_Row_2 a ex:TableRow .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_25 ex:hasRow ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_25_Row_2 .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_25_Row_2 ex:Feature "Mechanical" .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_25_Row_2 ex:Graphene_Foam_rGO "Brittle/Soft.Needs a binder (Vitrimer) to hold shape." .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_25_Row_2 ex:CNT_Foam "Elastic/Springy.Can survive compression shock." .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_25_Row_2 ex:Foamed_Lignin "Rigid/Structural.Can effectivelybethe roof of the chip." .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_26 a ex:DataTable ;
    rdfs:label "Data Table in File Summary" .
ex:Speckle_Metamaterials_and_Fast_Sensing_File_Summary ex:hasDataTable ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_26 .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_26_Row_0 a ex:TableRow .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_26 ex:hasRow ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_26_Row_0 .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_26_Row_0 ex:Feature "RF Absorption" .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_26_Row_0 ex:Graphene_Foam_rGO "High.Sheets absorb broad-spectrum RF. Tunable by density." .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_26_Row_0 ex:VACNT_Vertically_Aligned "Perfect.The aligned \"forest\" acts as an index-matched trap. Incident waves traveldownthe tubes and get absorbed without reflecting." .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_26_Row_0 ex:Foamed_Lignin "Low.Only conductive if carbonized (>900∘C). Otherwise, it is effectively transparent to RF (it's just wood foam)." .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_26_Row_1 a ex:TableRow .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_26 ex:hasRow ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_26_Row_1 .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_26_Row_1 ex:Feature "Thermal Conductivity" .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_26_Row_1 ex:Graphene_Foam_rGO "Excellent (>100 W/mK).It is a phononic superhighway." .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_26_Row_1 ex:VACNT_Vertically_Aligned "Anisotropic.Amazing vertically (along the tube), poor laterally. It pipes heatupbut notout." .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_26_Row_1 ex:Foamed_Lignin "Poor (Insulator).Great for keeping the rest of the chip cool, bad for removing waste heat." .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_26_Row_2 a ex:TableRow .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_26 ex:hasRow ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_26_Row_2 .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_26_Row_2 ex:Feature "Mechanical" .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_26_Row_2 ex:Graphene_Foam_rGO "Soft.Needs a binder (Vitrimer) to hold shape." .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_26_Row_2 ex:VACNT_Vertically_Aligned "Fragile/Elastic.Can be crushed easily." .
ex:Table_Speckle_Metamaterials_and_Fast_Sensing_File_Summary_26_Row_2 ex:Foamed_Lignin "Structural.Can effectivelybethe roof of the chip." .
