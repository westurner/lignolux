ex:Photon_s_Phase_Fingerprint_on_Particles_File_Summary ex:hasDataTable ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_0 .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_0_Row_0 a ex:TableRow .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_0 ex:hasRow ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_0_Row_0 .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_0_Row_0 ex:Effect "Polarization Phase" .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_0_Row_0 ex:Description "The medium's collective electronic cloud oscillates in sync with the photon, delaying the light's progress (the cause of the refractive index)." .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_0_Row_1 a ex:TableRow .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_0 ex:hasRow ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_0_Row_1 .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_0_Row_1 ex:Effect "Atomic Excitation Time" .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_0_Row_1 ex:Description "Recent research shows that even transmitted photons spend a measurable \"dwell time\" as a collective excitation within the atoms." .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_0_Row_2 a ex:TableRow .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_0 ex:hasRow ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_0_Row_2 .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_0_Row_2 ex:Effect "Geometric (Berry) Phase" .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_0_Row_2 ex:Description "If the photon's path or the medium's properties change in a specific curved geometry, the particles can acquire a \"geometric phase\" that depends only on the path taken, not the time spent." .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1 a ex:DataTable ;
    rdfs:label "Data Table in File Summary" .
ex:Photon_s_Phase_Fingerprint_on_Particles_File_Summary ex:hasDataTable ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1 .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1_Row_0 a ex:TableRow .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1 ex:hasRow ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1_Row_0 .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1_Row_0 ex:Feature "Destructivity" .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1_Row_0 ex:Standard_Projective_Measurement "Often destroys the qubit (e.g., absorbing a photon or ejecting an electron)." .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1_Row_0 ex:Phase_Based_Dispersive_M_Gate "Non-destructive.The qubit stays in its state after the measurement." .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1_Row_1 a ex:TableRow .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1 ex:hasRow ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1_Row_1 .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1_Row_1 ex:Feature "Repeatability" .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1_Row_1 ex:Standard_Projective_Measurement "You get one shot; if you miss it, the data is gone." .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1_Row_1 ex:Phase_Based_Dispersive_M_Gate "Repeatable.You can measure the same qubit multiple times to increase confidence." .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1_Row_2 a ex:TableRow .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1 ex:hasRow ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1_Row_2 .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1_Row_2 ex:Feature "Speed" .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1_Row_2 ex:Standard_Projective_Measurement "Can be slow (milliseconds for some spin-to-charge methods)." .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1_Row_2 ex:Phase_Based_Dispersive_M_Gate "Ultra-fast.Can take less than 100 nanoseconds." .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1_Row_3 a ex:TableRow .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1 ex:hasRow ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1_Row_3 .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1_Row_3 ex:Feature "Error Correction" .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1_Row_3 ex:Standard_Projective_Measurement "Hard to use for mid-circuit checks." .
ex:Table_Photon_s_Phase_Fingerprint_on_Particles_File_Summary_1_Row_3 ex:Phase_Based_Dispersive_M_Gate "Essential for Error Correction.Allows the computer to check for errors without stopping the calculation." .
